// ============================================================================
// Loyalty Platform — Prisma Schema
// Module 1: Customer & CRM
//
// Stack: Node.js/TypeScript + Prisma + Supabase (Postgres) + Vercel
//
// Conventions used throughout this schema (kept consistent for future
// modules — Transactions, Wallet & Credit, Reward Engine, etc.):
//   - snake_case in the database (via @map / @@map), camelCase in TS
//   - UUID primary keys (gen_random_uuid(), Supabase has pgcrypto enabled)
//   - Soft delete via `deletedAt` where AVG/right-to-be-forgotten applies
//   - Money fields use Decimal(10,2)
//   - Multi-tenant: every table that isn't purely global carries
//     organizationId, either directly or via its parent relation
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Supabase: use the pooled (pgbouncer) connection for the app at runtime,
  // and the direct connection for migrations. See README for setup.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ----------------------------------------------------------------------------
// Tenancy
// ----------------------------------------------------------------------------

model Organization {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  locations           Location[]
  customers           Customer[]
  customerTags        CustomerTag[]
  customerCustomFields CustomerCustomField[]
  auditLogs           AuditLog[]
  staffUsers          StaffUser[]
  voucherTemplates    VoucherTemplate[]
  customerVouchers    CustomerVoucher[]

  @@map("organizations")
}

// Echte, geverifieerde backoffice-gebruikers — vervangt de vorige
// "auth-stub" waarbij organizationId/permissions/actorId zomaar uit
// client-headers werden overgenomen zonder enige controle. Wachtwoord
// wordt altijd als bcrypt-hash opgeslagen, nooit als platte tekst.
// `permissions` is bewust een losse lijst strings (zelfde policy-based
// aanpak als de rest van het systeem al gebruikte) i.p.v. een vaste
// rollentabel — een organisatie kan zo zelf rollen samenstellen.
model StaffUser {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId        String    @map("organization_id") @db.Uuid
  email                 String
  passwordHash          String    @map("password_hash")
  firstName             String    @map("first_name")
  lastName              String?   @map("last_name")
  permissions           String[]
  isActive              Boolean   @default(true) @map("is_active")
  failedLoginAttempts   Int       @default(0) @map("failed_login_attempts")
  lockedUntil           DateTime? @map("locked_until")
  lastLoginAt           DateTime? @map("last_login_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sessions     StaffSession[]

  @@unique([organizationId, email])
  @@map("staff_users")
}

model StaffSession {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  staffUserId String    @map("staff_user_id") @db.Uuid
  tokenHash   String    @unique @map("token_hash")
  deviceInfo  String?   @map("device_info")
  createdAt   DateTime  @default(now()) @map("created_at")
  expiresAt   DateTime  @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")

  staffUser StaffUser @relation(fields: [staffUserId], references: [id], onDelete: Cascade)

  @@index([staffUserId])
  @@map("staff_sessions")
}

model Location {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  // Onderscheidt de merken (Het Strand / Zomers) die dezelfde centrale
  // klantomgeving delen — bepaalt branding op de klantportal-pagina.
  slug           String?  @unique
  timezone       String   @default("Europe/Amsterdam")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization        Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customerLocations   CustomerLocation[]
  timelineEvents      CustomerTimelineEvent[]
  favoriteOfCustomers Customer[]          @relation("FavoriteLocation")

  // Module 2 — Transactions & POS
  posConnections PosConnection[]
  transactions   Transaction[]

  // Module 4 — Reward Engine
  rewardRules        RewardRule[]
  rewardLocationCaps RewardLocationCap[]

  // Module 3 — Wallet & Credit
  creditRules CreditRule[]
  redemptionRateRules RedemptionRateRule[]
  // rewardCatalogItems verwijderd — RewardCatalogItem gebruikt nu
  // locationIds: String[] (geen FK-relatie meer), zelfde patroon als
  // VoucherTemplate.locationIds.

  // Module 9 — Reservations & Occupancy Booster
  capacitySettings       LocationCapacitySetting[]
  reservationConnections ReservationConnection[]
  reservations           Reservation[]
  weatherForecasts       WeatherForecast[]
  forecastRuns           ForecastRun[]
  occupancyOpportunities OccupancyOpportunity[]

  @@index([organizationId])
  @@map("locations")
}

// ----------------------------------------------------------------------------
// Core customer profile
// ----------------------------------------------------------------------------

enum LoyaltyStatus {
  active
  inactive
  blocked
  merged
}

enum SourceChannel {
  pos
  qr
  website
  reservation
  wallet
  manual
  import
}

model Customer {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  firstName   String? @map("first_name")
  lastName    String? @map("last_name")
  email       String?
  phone       String?
  dateOfBirth DateTime? @map("date_of_birth") @db.Date
  language    String    @default("nl")

  // Optioneel wachtwoord voor de klantportal — NAAST de bestaande
  // e-mailcode-login, nooit als vervanging. Nullable: klanten die nooit
  // een wachtwoord instellen blijven gewoon de codeflow gebruiken. Enkel
  // een bcrypt-hash wordt opgeslagen, nooit het wachtwoord zelf.
  passwordHash String? @map("password_hash")
  passwordFailedAttempts Int       @default(0) @map("password_failed_attempts")
  passwordLockedUntil    DateTime? @map("password_locked_until")

  // Herkomst-identificatie voor migraties (bijv. Piggy-import) — maakt
  // toekomstige heraanlevering van dezelfde bron veilig herkenbaar,
  // zonder een apart identificatie-model te introduceren.
  externalId     String? @map("external_id")
  externalSource String? @map("external_source")

  loyaltyStatus LoyaltyStatus @default(active) @map("loyalty_status")

  // Forward-looking: full tier system is designed in a later module.
  // Kept nullable + FK-ready so we don't need a breaking migration then.
  tierId String? @map("tier_id") @db.Uuid
  tier   LoyaltyTier? @relation(fields: [tierId], references: [id])

  // Denormalized read-cache. Source of truth lives in Module 2 (Transactions)
  // and Module 3 (Wallet & Credit). Never written to directly by the API —
  // only updated by event consumers. See README "Event-driven cache fields".
  currentBalance             Decimal  @default(0) @map("current_balance") @db.Decimal(10, 2)
  lifetimeEarned              Decimal  @default(0) @map("lifetime_earned") @db.Decimal(10, 2)
  lifetimeRedeemed            Decimal  @default(0) @map("lifetime_redeemed") @db.Decimal(10, 2)
  visitCount                  Int      @default(0) @map("visit_count")
  lifetimeSpend                Decimal  @default(0) @map("lifetime_spend") @db.Decimal(10, 2)
  averageSpend                 Decimal? @map("average_spend") @db.Decimal(10, 2)
  firstVisitAt                 DateTime? @map("first_visit_at")
  lastVisitAt                  DateTime? @map("last_visit_at")
  averageVisitFrequencyDays    Int?      @map("average_visit_frequency_days")

  favoriteLocationId String?   @map("favorite_location_id") @db.Uuid
  favoriteLocation   Location? @relation("FavoriteLocation", fields: [favoriteLocationId], references: [id])

  favoriteVisitDay        String? @map("favorite_visit_day")
  favoriteVisitTimeWindow String? @map("favorite_visit_time_window")
  favoritePartySize        Int?    @map("favorite_party_size")

  interests   Json @default("[]") @map("interests")
  preferences Json @default("{}") @map("preferences")

  sourceChannel SourceChannel @default(manual) @map("source_channel")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  identities         CustomerIdentity[]
  locationsBreakdown CustomerLocation[]
  consents           CustomerConsent[]
  consentHistory     CustomerConsentHistory[]
  timelineEvents     CustomerTimelineEvent[]
  notes              CustomerNote[]
  tags               CustomerTagMap[]
  customFieldValues  CustomerCustomFieldValue[]

  mergedInto   CustomerMergeLog[] @relation("SurvivingCustomer")
  mergedFrom   CustomerMergeLog[] @relation("MergedCustomer")

  // Module 2 — Transactions & POS
  transactions           Transaction[]
  posCustomerMappings    PosCustomerMapping[]

  // Module 4 — Reward Engine
  rewardCustomerCaps       RewardCustomerCap[]
  rewardCalculations       RewardCalculation[]
  rewardChallengeProgress  RewardChallengeProgress[]

  // Module 3 — Wallet & Credit
  wallet Wallet?

  // Module 5 — Campaign Manager
  campaignAudienceSnapshots CampaignAudienceSnapshot[]
  campaignRecipients        CampaignRecipient[]

  // Module 6 — Messaging
  pushTokens          CustomerPushToken[]
  messageQueueItems   MessageQueueItem[]
  messageSendLogs     CustomerMessageSendLog[]

  // Module 7 — Segmentation Engine
  segmentMemberships SegmentMembership[]
  churnRiskScore     ChurnRiskScore?

  // Module 8 — Automated Journeys
  journeyEnrollments JourneyEnrollment[]

  // Module 9 — Reservations & Occupancy Booster
  reservations Reservation[]

  // Guest App Authentication
  guestLoginCodes GuestLoginCode[]
  guestSessions   GuestSession[]
  guestPushTokens GuestPushToken[]

  // Fysieke loyaltykaarten
  loyaltyCards LoyaltyCard[]

  // Cadeaukaarten — apart van loyaltytegoed
  giftCardsPurchased GiftCard[] @relation("GiftCardPurchaser")
  giftCardsReceived  GiftCard[] @relation("GiftCardRecipient")
  vouchers           CustomerVoucher[]

  // Klantportal-QR (Mijn Tegoed)
  qrTokens CustomerQrToken[]

  // Unique identity per organization — enforced at the identity table level
  // (email/phone can be null here; the real uniqueness constraint that
  // prevents duplicate people lives on CustomerIdentity).
  @@index([organizationId])
  @@index([organizationId, email])
  @@index([organizationId, phone])
  @@index([organizationId, loyaltyStatus])
  @@index([organizationId, externalSource, externalId])
  @@map("customers")
}

// Forward-looking stub for the future tier system (not fully designed yet —
// referenced here only so Customer.tierId has a valid, non-breaking target).
model LoyaltyTier {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  name           String
  createdAt      DateTime @default(now()) @map("created_at")

  customers Customer[]
  rewardRules RewardRule[]

  @@map("loyalty_tiers")
}

// ----------------------------------------------------------------------------
// Identity resolution
// ----------------------------------------------------------------------------

enum IdentityType {
  email
  phone
  qr_code
  wallet_pass_id
  pos_customer_ref
  external_crm_id
}

model CustomerIdentity {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  customerId     String       @map("customer_id") @db.Uuid
  identityType   IdentityType @map("identity_type")
  identityValue  String       @map("identity_value") // normalized (lowercase email, E.164 phone)
  isPrimary      Boolean      @default(false) @map("is_primary")
  verified       Boolean      @default(false)
  source         SourceChannel
  createdAt      DateTime     @default(now()) @map("created_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  // Core anti-duplicate rule: one identity value can only belong to one
  // customer within an organization.
  @@unique([organizationId, identityType, identityValue])
  @@index([customerId])
  @@map("customer_identities")
}

// ----------------------------------------------------------------------------
// Per-location statistics
// ----------------------------------------------------------------------------

model CustomerLocation {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId    String   @map("customer_id") @db.Uuid
  locationId    String   @map("location_id") @db.Uuid
  visitCount    Int      @default(0) @map("visit_count")
  spendTotal    Decimal  @default(0) @map("spend_total") @db.Decimal(10, 2)
  firstVisitAt  DateTime? @map("first_visit_at")
  lastVisitAt   DateTime? @map("last_visit_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([customerId, locationId])
  @@index([locationId])
  @@map("customer_locations")
}

// ----------------------------------------------------------------------------
// Consent / AVG
// ----------------------------------------------------------------------------

enum ConsentType {
  marketing
  email
  sms
  push
  profiling
  data_sharing_partners
}

enum ConsentSource {
  signup_form
  pos_prompt
  wallet_signup
  website
  import
  manual_staff
  api
}

enum ConsentAction {
  granted
  revoked
}

model CustomerConsent {
  id                    String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId            String        @map("customer_id") @db.Uuid
  consentType           ConsentType   @map("consent_type")
  granted               Boolean
  grantedAt             DateTime?     @map("granted_at")
  revokedAt             DateTime?     @map("revoked_at")
  source                ConsentSource
  privacyPolicyVersion  String        @map("privacy_policy_version")
  ipAddress             String?       @map("ip_address")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  // One current-state row per customer per consent channel.
  @@unique([customerId, consentType])
  @@map("customer_consents")
}

model CustomerConsentHistory {
  id                   String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId           String        @map("customer_id") @db.Uuid
  consentType          ConsentType   @map("consent_type")
  action               ConsentAction
  timestamp            DateTime      @default(now())
  source               ConsentSource
  privacyPolicyVersion String        @map("privacy_policy_version")
  actor                String        // "customer" or a staff user id

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, consentType])
  @@map("customer_consent_history")
}

// ----------------------------------------------------------------------------
// Timeline
// ----------------------------------------------------------------------------

enum TimelineEventType {
  account_created
  profile_updated
  visit
  transaction
  credit_earned
  credit_redeemed
  credit_expired
  credit_manual_adjustment
  reward_granted
  reward_used
  reservation_created
  reservation_completed
  reservation_no_show
  push_sent
  push_opened
  email_sent
  email_opened
  sms_sent
  campaign_targeted
  coupon_issued
  coupon_redeemed
  manual_change
  cs_note_added
  consent_changed
  merge_performed
  segment_entered
  segment_left
}

model CustomerTimelineEvent {
  id                  String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId          String            @map("customer_id") @db.Uuid
  organizationId      String            @map("organization_id") @db.Uuid
  locationId          String?           @map("location_id") @db.Uuid
  eventType           TimelineEventType @map("event_type")
  eventSourceModule   String            @map("event_source_module") // 'crm' | 'transactions' | 'wallet' | ...
  eventSourceId       String?           @map("event_source_id") @db.Uuid
  payload             Json              @default("{}")
  occurredAt          DateTime          @map("occurred_at")
  createdAt           DateTime          @default(now()) @map("created_at")

  customer Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  location Location? @relation(fields: [locationId], references: [id])

  @@index([customerId, occurredAt])
  @@index([organizationId, eventType])
  @@map("customer_timeline_events")
}

// ----------------------------------------------------------------------------
// Notes
// ----------------------------------------------------------------------------

enum NoteType {
  general
  complaint
  preference
  allergy
  vip_flag
}

enum NoteVisibility {
  organization
  location_only
}

model CustomerNote {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId    String         @map("customer_id") @db.Uuid
  authorUserId  String         @map("author_user_id") @db.Uuid
  noteType      NoteType       @default(general) @map("note_type")
  content       String
  visibility    NoteVisibility @default(organization)
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("customer_notes")
}

// ----------------------------------------------------------------------------
// Tags
// ----------------------------------------------------------------------------

model CustomerTag {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  label          String
  color          String   @default("#64748B")
  createdBy      String?  @map("created_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customers    CustomerTagMap[]

  @@unique([organizationId, label])
  @@map("customer_tags")
}

model CustomerTagMap {
  customerId String   @map("customer_id") @db.Uuid
  tagId      String   @map("tag_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  customer Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tag      CustomerTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([customerId, tagId])
  @@map("customer_tag_map")
}

// ----------------------------------------------------------------------------
// Custom fields (per-organization, no schema migration needed)
// ----------------------------------------------------------------------------

enum CustomFieldType {
  text
  number
  boolean
  date
  select
}

model CustomerCustomField {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  fieldKey       String          @map("field_key")
  fieldLabel     String          @map("field_label")
  fieldType      CustomFieldType @map("field_type")
  options        Json?           // used when fieldType = select
  deletedAt      DateTime?       @map("deleted_at") // soft delete, see Edge case #10
  createdAt      DateTime        @default(now()) @map("created_at")

  organization Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  values       CustomerCustomFieldValue[]

  @@unique([organizationId, fieldKey])
  @@map("customer_custom_fields")
}

model CustomerCustomFieldValue {
  customerId    String @map("customer_id") @db.Uuid
  customFieldId String @map("custom_field_id") @db.Uuid
  value         Json

  customer    Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customField CustomerCustomField @relation(fields: [customFieldId], references: [id], onDelete: Cascade)

  @@id([customerId, customFieldId])
  @@map("customer_custom_field_values")
}

// ----------------------------------------------------------------------------
// Merge log
// ----------------------------------------------------------------------------

enum MergeType {
  automatic
  manual
}

model CustomerMergeLog {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  survivingCustomerId    String    @map("surviving_customer_id") @db.Uuid
  mergedCustomerId       String    @map("merged_customer_id") @db.Uuid
  mergedFieldsSnapshot   Json      @map("merged_fields_snapshot")
  matchScore             Decimal   @map("match_score") @db.Decimal(5, 4)
  mergeType              MergeType @map("merge_type")
  performedBy            String?   @map("performed_by") @db.Uuid
  performedAt            DateTime  @default(now()) @map("performed_at")

  survivingCustomer Customer @relation("SurvivingCustomer", fields: [survivingCustomerId], references: [id])
  mergedCustomer    Customer @relation("MergedCustomer", fields: [mergedCustomerId], references: [id])

  @@index([survivingCustomerId])
  @@index([mergedCustomerId])
  @@map("customer_merge_log")
}

// ----------------------------------------------------------------------------
// Segmentation is fully implemented in Module 7 (see below). The forward-
// looking stub that used to live here has been replaced by the real
// Segment/SegmentMembership models further down this file.
// ----------------------------------------------------------------------------


// ----------------------------------------------------------------------------
// Audit log (shared infrastructure, used by all modules)
// ----------------------------------------------------------------------------

enum AuditAction {
  create
  update
  delete
  merge
  anonymize
  export
}

enum ActorType {
  staff
  system
  api_key
  customer_self_service
}

model AuditLog {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  entityType     String      @map("entity_type") // e.g. 'customer', 'customer_consent', 'customer_note'
  entityId       String      @map("entity_id") @db.Uuid
  action         AuditAction
  actorType      ActorType   @map("actor_type")
  actorId        String?     @map("actor_id") @db.Uuid
  beforeState    Json?       @map("before_state")
  afterState     Json?       @map("after_state")
  reason         String?
  ipAddress      String?     @map("ip_address")
  timestamp      DateTime    @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, entityType, entityId])
  @@index([organizationId, timestamp])
  @@map("audit_log")
}

// ============================================================================
// Module 2 — Transactions & POS
// ============================================================================

enum PosConnectionMode {
  webhook
  polling
  bulk_only
}

enum PosConnectionStatus {
  active
  paused
  error
  not_configured
}

model PosConnection {
  id             String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String              @map("organization_id") @db.Uuid
  locationId     String              @map("location_id") @db.Uuid
  // Deliberately a free-form string, not a fixed enum — new POS providers
  // must be addable without a schema migration (see Module 2 design doc,
  // section 9: "geen hardcoded enum-limiet").
  provider              String
  connectionMode        PosConnectionMode   @map("connection_mode")
  apiCredentialsRef     String?             @map("api_credentials_ref")
  webhookSecretRef      String?             @map("webhook_secret_ref")
  pollingIntervalSeconds Int?               @map("polling_interval_seconds")
  lastSyncedAt          DateTime?           @map("last_synced_at")
  lastSuccessfulSyncAt  DateTime?           @map("last_successful_sync_at")
  status                PosConnectionStatus @default(not_configured)
  createdAt             DateTime            @default(now()) @map("created_at")
  updatedAt             DateTime            @updatedAt @map("updated_at")

  location             Location              @relation(fields: [locationId], references: [id], onDelete: Cascade)
  events               PosEvent[]
  transactions         Transaction[]
  productMappings      PosProductMapping[]
  customerMappings     PosCustomerMapping[]
  syncRuns             PosSyncRun[]

  @@index([organizationId])
  @@index([locationId])
  @@map("pos_connections")
}

enum IngestionMethod {
  webhook
  poll
  bulk_import
  csv_upload
}

enum PosEventProcessingStatus {
  pending
  processed
  failed
  ignored_duplicate
}

model PosEvent {
  id                String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  posConnectionId   String                    @map("pos_connection_id") @db.Uuid
  ingestionMethod   IngestionMethod           @map("ingestion_method")
  rawPayload        Json                      @map("raw_payload")
  payloadHash       String                    @map("payload_hash")
  receivedAt        DateTime                  @default(now()) @map("received_at")
  processingStatus  PosEventProcessingStatus  @default(pending) @map("processing_status")
  transactionId     String?                   @map("transaction_id") @db.Uuid

  posConnection PosConnection @relation(fields: [posConnectionId], references: [id], onDelete: Cascade)
  transaction   Transaction?  @relation(fields: [transactionId], references: [id])
  failedTransactions FailedTransaction[]

  @@index([posConnectionId, payloadHash])
  @@index([posConnectionId, receivedAt])
  @@map("pos_events")
}

enum TransactionSource {
  pos
  manual
  csv_import
}

enum TransactionStatus {
  pending
  completed
  failed
  voided
  partially_refunded
  refunded
  charged_back
}

enum PaymentMethod {
  cash
  card
  ideal
  voucher
  split
  other
}

model Transaction {
  id                     String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId         String             @map("organization_id") @db.Uuid
  locationId             String             @map("location_id") @db.Uuid
  posConnectionId        String?            @map("pos_connection_id") @db.Uuid
  source                 TransactionSource  @default(manual)
  externalTransactionId  String?            @map("external_transaction_id")
  customerId             String?            @map("customer_id") @db.Uuid
  tableReference         String?            @map("table_reference")
  reservationId          String?            @map("reservation_id") @db.Uuid
  status                 TransactionStatus  @default(pending)
  grossAmount            Decimal            @map("gross_amount") @db.Decimal(10, 2)
