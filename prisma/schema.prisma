// Cadeaucatalogus: vaste items inwisselbaar tegen een vast puntenaantal
// (bijv. "Gebakje bij de koffie — 100 punten"), naast de generieke
// blokgewijze tegoed-inwisseling hierboven.
model RewardCatalogItem {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  // Leeg/null array = organisatiebreed geldig, gevuld = alleen geldig bij
  // de genoemde locatie(s) — zelfde patroon als VoucherTemplate.locationIds
  // hieronder, i.p.v. de vorige losse locationId-relatie (max. 1 locatie).
  locationIds    String[] @default([]) @map("location_ids") @db.Uuid
  name           String
  description    String?
