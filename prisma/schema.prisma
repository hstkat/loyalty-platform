// ============================================================================
// Data Import (Piggy-migratie e.d.) — hergebruikt Customer/Wallet/ledger,
// geen los klant- of saldomodel. Bestandsinhoud wordt tijdelijk als JSON
// bewaard op de job zelf (geen objectopslag beschikbaar in deze omgeving),
// en na afronding leeggemaakt (zie ImportService — bewuste, gedocumenteerde
// keuze i.p.v. een aparte bestandsopslagdienst).
// ============================================================================

enum ImportJobStatus {
  parsed
  previewed
  processing
  completed
  failed
  rolled_back
}

enum ImportRowAction {
  new_customer
  matched_customer
  review_required
  invalid
  skip
  duplicate
}

model ImportJob {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  locationId     String?  @map("location_id") @db.Uuid
  source         String   @default("piggy")
  filename       String
  fileHash       String   @map("file_hash")

  status         ImportJobStatus @default(parsed)

  totalRows      Int      @default(0) @map("total_rows")
  processedRows  Int      @default(0) @map("processed_rows")
  successRows    Int      @default(0) @map("success_rows")
  errorRows      Int      @default(0) @map("error_rows")
  reviewRows     Int      @default(0) @map("review_rows")
  duplicateRows  Int      @default(0) @map("duplicate_rows")

  columnMapping  Json?    @map("column_mapping")
  // "ratio" (bijv. 100 punten = €1) of "one_to_one" (1 punt = 1 punt)
  conversionType String?  @map("conversion_type")
  conversionRate Decimal? @map("conversion_rate") @db.Decimal(10, 4)
  // "add" (veilige standaard) of "replace" (met correctie-ledgerentry)
  balanceMode    String   @default("add") @map("balance_mode")

  totalSourceBalance    Decimal? @map("total_source_balance") @db.Decimal(14, 2)
  totalConvertedCredit  Decimal? @map("total_converted_credit") @db.Decimal(14, 2)

  // Tijdelijke opslag van de geparste rijen — geleegd na afronding of na
  // de retentieperiode (zie ImportService.purgeExpiredRawData).
  rawRows Json? @map("raw_rows")

  createdByUserId String?   @map("created_by_user_id") @db.Uuid
  startedAt       DateTime? @map("started_at")
  completedAt     DateTime? @map("completed_at")
  rolledBackAt    DateTime? @map("rolled_back_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  records ImportRecord[]

  @@index([organizationId, createdAt])
  @@index([organizationId, fileHash])
  @@map("import_jobs")
}

model ImportRecord {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  importJobId String @map("import_job_id") @db.Uuid

  rowNumber Int    @map("row_number")
  rowHash   String @map("row_hash")
  rawData   Json   @map("raw_data")

  action            ImportRowAction
  matchedCustomerId String? @map("matched_customer_id") @db.Uuid
  sourceBalance     Decimal? @map("source_balance") @db.Decimal(14, 2)
  convertedCredit   Decimal? @map("converted_credit") @db.Decimal(14, 2)
  errorMessage      String? @map("error_message")

  ledgerEntryId         String? @map("ledger_entry_id") @db.Uuid
  reversalLedgerEntryId String? @map("reversal_ledger_entry_id") @db.Uuid
  customerCreatedByImport Boolean @default(false) @map("customer_created_by_import")

  committedAt DateTime? @map("committed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  importJob ImportJob @relation(fields: [importJobId], references: [id], onDelete: Cascade)

  @@unique([importJobId, rowHash])
  @@index([importJobId, action])
  @@map("import_records")
}

// ============================================================================
// Fysieke loyaltykaarten (QR-token → LoyaltyCard → Customer → Wallet)
// Een kaart is bewust GEEN Customer en bezit zelf nooit het saldo — het
// saldo blijft altijd bij de Wallet van de gekoppelde Customer. Dit maakt
// vervangen/blokkeren/opnieuw koppelen altijd veilig, zonder saldo-risico.
// ============================================================================

enum LoyaltyCardBatchStatus {
  generating
  ready
  exported
}

enum LoyaltyCardStatus {
  unclaimed
  active
  blocked
  lost
  replaced
  expired
}

model LoyaltyCardBatch {
  id             String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String                 @map("organization_id") @db.Uuid
  locationId     String?                @map("location_id") @db.Uuid
  name           String
  quantity       Int
  status         LoyaltyCardBatchStatus @default(generating)
  createdByUserId String?               @map("created_by_user_id") @db.Uuid
  createdAt      DateTime               @default(now()) @map("created_at")
  exportedAt     DateTime?              @map("exported_at")

  cards LoyaltyCard[]

  @@index([organizationId, createdAt])
  @@map("loyalty_card_batches")
}

model LoyaltyCard {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  locationId     String?  @map("location_id") @db.Uuid
  batchId        String?  @map("batch_id") @db.Uuid
  customerId     String?  @map("customer_id") @db.Uuid

  // Nooit de ruwe token opslaan — zelfde principe als bij inlogcodes en
  // sessietokens elders in dit platform: bij een databaselek kan een
  // aanvaller zo geen geldige kaarten "namaken" uit de dump.
  publicTokenHash String @unique @map("public_token_hash")
  cardNumber      String @unique @map("card_number") // bijv. "BC-000001" — puur administratief, NOOIT de beveiliging

  status      LoyaltyCardStatus @default(unclaimed)
  pendingBalance Decimal @default(0) @map("pending_balance") @db.Decimal(10, 2) // ongeregistreerd sparen vóór claim — zie LoyaltyCardPendingEntry

  issuedAt         DateTime  @default(now()) @map("issued_at")
  claimedAt        DateTime? @map("claimed_at")
  blockedAt        DateTime? @map("blocked_at")
  blockedReason    String?   @map("blocked_reason")
  lastUsedAt       DateTime? @map("last_used_at")
  replacedByCardId String?   @unique @map("replaced_by_card_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  batch       LoyaltyCardBatch? @relation(fields: [batchId], references: [id])
  customer    Customer?         @relation(fields: [customerId], references: [id])
  replacedBy  LoyaltyCard?      @relation("CardReplacement", fields: [replacedByCardId], references: [id])
  replacesCard LoyaltyCard?     @relation("CardReplacement")
  pendingEntries LoyaltyCardPendingEntry[]

  @@index([organizationId, status])
  @@index([customerId])
  @@map("loyalty_cards")
}

// Ongeregistreerd sparen: een nog niet-geclaimde kaart kan al tegoed
// opbouwen. Bewust GEEN eigen Wallet voor de kaart (dat zou een parallel
// saldosysteem naast de bestaande Wallet-architectuur betekenen) — bij
// claim wordt dit in één atomaire transactie omgezet in een echte
// WalletLedgerEntry (entryType 'transfer') op de Wallet van de klant.
model LoyaltyCardPendingEntry {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cardId    String   @map("card_id") @db.Uuid
  amount    Decimal  @db.Decimal(10, 2)
  reason    String?
  createdAt DateTime @default(now()) @map("created_at")

  card LoyaltyCard @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([cardId])
  @@map("loyalty_card_pending_entries")
}

// ============================================================================
// Cadeaukaarten (Gift Cards) — bewust volledig gescheiden van het
// loyaltytegoed:
//
//   Customer -> Wallet -> WalletLedgerEntry        (loyaltytegoed)
//   GiftCard -> GiftCardLedgerEntry                (cadeaukaart-saldo)
//
// Een cadeaukaart heeft GEEN eigen Wallet en een Wallet heeft geen
// cadeaukaart-saldo — dat voorkomt dat de twee financieel door elkaar
// lopen, ook al kunnen ze bij dezelfde rekening samen gebruikt worden.
//
// Belangrijke ontwerpkeuze: de VERKOOP van een cadeaukaart loopt bewust
// NIET via het bestaande /transactions-endpoint (dat de beloningsengine
// aanroept) — een cadeaukaart-verkoop raakt de reward engine daardoor
// nooit, wat "geen loyaltytegoed bij aankoop van een cadeaukaart"
// architecturaal afdwingt zonder een uitzondering in die engine zelf
// nodig te hebben. Het latere GEBRUIK van een cadeaukaart als
// betaalmiddel loopt wél via een normale transactie (net als contant/
// pin), en verdient dus gewoon normaal loyaltytegoed.
// ============================================================================

enum GiftCardStatus {
  draft
  active
  partially_redeemed
  redeemed
  blocked
  expired
  cancelled
}

enum GiftCardLedgerEntryType {
  issue
  sale
  redeem
  top_up
  refund
  reversal
  adjustment
  expiration
}

enum GiftCardBatchStatus {
  generating
  ready
  exported
}

model GiftCardBatch {
  id              String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String              @map("organization_id") @db.Uuid
  locationId      String?             @map("location_id") @db.Uuid
  name            String
  quantity        Int
  status          GiftCardBatchStatus @default(generating)
  createdByUserId String?             @map("created_by_user_id") @db.Uuid
  createdAt       DateTime            @default(now()) @map("created_at")
  exportedAt      DateTime?           @map("exported_at")

  cards GiftCard[]

  @@index([organizationId, createdAt])
  @@map("gift_card_batches")
}

model GiftCard {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  batchId        String? @map("batch_id") @db.Uuid

  giftCardNumber  String @unique @map("gift_card_number") // bijv. "GC-000001" — administratief, nooit de beveiliging
  publicTokenHash String @unique @map("public_token_hash") // zelfde principe als LoyaltyCard: nooit het ruwe token bewaren

  status         GiftCardStatus @default(draft)
  originalValue  Decimal        @map("original_value") @db.Decimal(10, 2)
  currentBalance Decimal        @default(0) @map("current_balance") @db.Decimal(10, 2)
  currency       String         @default("EUR")

  purchaserCustomerId String? @map("purchaser_customer_id") @db.Uuid
  recipientCustomerId String? @map("recipient_customer_id") @db.Uuid
  recipientName       String? @map("recipient_name")
  recipientEmail      String? @map("recipient_email")
  // Afzender bij online aankoop — losse vrije-tekstvelden (geen
  // koppeling aan een klantaccount, in tegenstelling tot
  // purchaserCustomerId hierboven, dat een AL BESTAAND account koppelt).
  // Nodig voor de aparte bevestigingsmail aan de koper zelf.
  senderName                String?   @map("sender_name")
  senderEmail               String?   @map("sender_email")
  senderConfirmationSentAt  DateTime? @map("sender_confirmation_sent_at")
  // Online verkoop via Mollie (iDEAL e.d.) — de kaart blijft bewust op
  // status 'draft' totdat de webhook een bevestigde betaling meldt; zie
  // MollieService voor de reden waarom nooit op de webhook-inhoud zelf
  // wordt vertrouwd, alleen op een verse statusopvraag bij Mollie.
  molliePaymentId     String? @map("mollie_payment_id")
  personalMessage     String? @map("personal_message")
  scheduledSendAt     DateTime? @map("scheduled_send_at") // geplande verzending (bijv. verjaardag) — zie GiftCardsService voor het bewuste, gedocumenteerde verzendmechanisme

  // Locatiescope — zelfde conventie als VoucherTemplate.locationIds: een
  // leeg array betekent organisatiebreed geldig (bij zowel Het Strand
  // als Zomers), een gevuld array beperkt de kaart tot precies die
  // locatie(s). Vervangt het oudere `locationId` (enkelvoud) +
  // `isOrganizationWide`-paar, dat overigens nooit daadwerkelijk werd
  // afgedwongen bij inwisseling — zie GiftCardsService.redeem().
  locationIds String[] @map("location_ids") @db.Uuid

  issuedAt          DateTime  @default(now()) @map("issued_at")
  activatedAt       DateTime? @map("activated_at")
  expiresAt         DateTime? @map("expires_at")
  expiryReminderSentAt DateTime? @map("expiry_reminder_sent_at") // 30-dagen-voor-verloop-herinnering — voorkomt dubbel versturen
  // Bewust een LOS veld van het bestaande batchId/batch-mechanisme
  // (vooraf gedrukte kaarten die via activate() worden geactiveerd) —
  // dit dekt de andere, veelvoorkomende situatie: een medewerker maakt
  // via het gewone "Kadobon uitgeven"-formulier (issue()) een kaart aan
  // én overhandigt daarbij een fysieke sticker/kaart, zonder de
  // batch-vooraf-drukken-flow te gebruiken. Bepaalt of de rapportage
  // deze verkoop bij "fysiek" of "digitaal" telt.
  isPhysical        Boolean   @default(false) @map("is_physical")
  blockedAt         DateTime? @map("blocked_at")
  blockedReason     String?   @map("blocked_reason")
  replacedByGiftCardId String? @unique @map("replaced_by_gift_card_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  batch             GiftCardBatch? @relation(fields: [batchId], references: [id])
  purchaser         Customer?      @relation("GiftCardPurchaser", fields: [purchaserCustomerId], references: [id])
  recipient         Customer?      @relation("GiftCardRecipient", fields: [recipientCustomerId], references: [id])
  replacedByGiftCard GiftCard?     @relation("GiftCardReplacement", fields: [replacedByGiftCardId], references: [id])
  replacesGiftCard   GiftCard?     @relation("GiftCardReplacement")
  ledgerEntries      GiftCardLedgerEntry[]

  @@index([organizationId, status])
  @@index([purchaserCustomerId])
  @@index([recipientCustomerId])
  @@index([molliePaymentId])
  @@map("gift_cards")
}

model GiftCardLedgerEntry {
  id            String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  giftCardId    String                  @map("gift_card_id") @db.Uuid
  organizationId String                 @map("organization_id") @db.Uuid
  locationId    String?                 @map("location_id") @db.Uuid
  entryType     GiftCardLedgerEntryType @map("entry_type")
  amount        Decimal                 @db.Decimal(10, 2) // positief = saldo erbij, negatief = saldo eraf
  transactionId String?                 @map("transaction_id") @db.Uuid // gekoppelde POS-transactie, indien van toepassing
  performedByUserId String?             @map("performed_by_user_id") @db.Uuid
  reason        String?
  metadata      Json?
  occurredAt    DateTime                @default(now()) @map("occurred_at")

  giftCard    GiftCard     @relation(fields: [giftCardId], references: [id], onDelete: Cascade)
  transaction Transaction? @relation(fields: [transactionId], references: [id])

  @@index([giftCardId, occurredAt])
  @@index([organizationId, occurredAt])
  @@map("gift_card_ledger_entries")
}

// ============================================================================
// Klantportal-QR (Mijn Tegoed) — bewust een APART, kortlevend
// tokensysteem, los van de fysieke-loyaltykaart-tokens. Een fysieke
// kaart bestaat fysiek in de wereld, dus het token hoeft nooit opnieuw
// getoond te worden na aanmaken. Een portal-QR moet elke keer dat een
// gast inlogt opnieuw zichtbaar zijn — dat vraagt om een ander patroon:
// kort geldig, makkelijk te vernieuwen, en met beperkte bevoegdheid
// (identificatie only — geen volledige accountsessie, dus een
// gefotografeerde QR geeft nooit toegang tot het hele account).
// ============================================================================

model CustomerQrToken {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  tokenHash  String   @unique @map("token_hash")
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("customer_qr_tokens")
}

// Aparte tabel (i.p.v. GuestLoginCode hergebruiken) voor codes aan een
// e-mailadres dat nog geen Customer heeft — GuestLoginCode vereist een
// bestaande customerId en wordt door de al bewezen inlogflow gebruikt;
// dit voorkomt elk risico daarop terwijl de nieuwe-klant-registratie
// wordt toegevoegd.
model GuestRegistrationCode {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  email          String
  codeHash       String    @map("code_hash")
  expiresAt      DateTime  @map("expires_at")
  usedAt         DateTime? @map("used_at")
  attempts       Int       @default(0)
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([organizationId, email])
  @@map("guest_registration_codes")
}

// ============================================================================
// Financiële rapportagemodule (kantoor/administratie) — bewaart alleen de
// RAPPORTPARAMETERS (periode, locatie, type, wie/wanneer), nooit het
// bestand zelf of een cache van de berekende bedragen. Een rapport kan
// altijd opnieuw met dezelfde parameters gegenereerd worden, en wordt dan
// vers uit de ledgers herberekend — zie FinancialReportsService. Dit is
// bewust GEEN tweede financiële administratie, puur een "geschiedenis van
// aanvragen" zodat kantoor niet steeds handmatig dezelfde periode hoeft
// in te stellen.
// ============================================================================

model FinancialReportHistory {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId      String   @map("organization_id") @db.Uuid
  reportType          String   @map("report_type") // 'today' | 'this_week' | 'last_week' | 'this_month' | 'last_month' | 'quarter' | 'year' | 'custom'
  periodStart         DateTime @map("period_start")
  periodEnd           DateTime @map("period_end")
  locationId          String?  @map("location_id") @db.Uuid // null = hele organisatie
  format              String   // 'excel' | 'pdf' | 'view' (alleen bekeken, niet geëxporteerd)
  generatedByStaffId  String?  @map("generated_by_staff_id") @db.Uuid
  generatedAt         DateTime @default(now()) @map("generated_at")

  @@index([organizationId, generatedAt])
  @@map("financial_report_history")
}
