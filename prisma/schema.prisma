// Vervangt de vorige in-process JavaScript Map voor het two-phase
// redemption-mechanisme (reserve -> confirm/cancel). Die Map overleefde
// geen herstart en werkte niet over meerdere serverless-instances heen
// (Vercel start voor elke aanroep mogelijk een ander functie-exemplaar)
// — een reservering kon daardoor spontaan "verdwijnen", en dubbele
// requests met dezelfde idempotencyKey werden niet betrouwbaar herkend.
// Nu een echte, gedeelde tabel: elke instance ziet dezelfde staat.
model WalletRedemptionReservation {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  walletId        String    @map("wallet_id") @db.Uuid
  customerId      String    @map("customer_id") @db.Uuid
  amount          Decimal   @db.Decimal(10, 2)
  lockedEntryIds  String[]  @map("locked_entry_ids") @db.Uuid
  transactionId   String?   @map("transaction_id") @db.Uuid
  idempotencyKey  String    @map("idempotency_key")
  status          String    @default("active") // 'active' | 'confirmed' | 'cancelled'
  createdAt       DateTime  @default(now()) @map("created_at")
  expiresAt       DateTime  @map("expires_at")

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, status])
  @@map("wallet_redemption_reservations")
}

