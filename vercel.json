{
  "version": 2,
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "functions": {
    "api/index.ts": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/backoffice/:path*", "destination": "/backoffice/:path*" },
    { "source": "/(.*)", "destination": "/api" }
  ],
  "crons": [
    {
      "path": "/cron/daily-closing",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/cron/voucher-expiry-reminders",
      "schedule": "0 8 * * *"
    }
  ]
}
