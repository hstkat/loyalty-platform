# Supabase — Project Settings > Database > Connection string
#
# DATABASE_URL: pooled connection (via Supavisor/pgbouncer), used by the
#               running app (Vercel serverless functions need pooling —
#               each function invocation opens a new connection, and Postgres
#               has a hard connection limit).
# DIRECT_URL:   direct connection, used only by Prisma Migrate (migrations
#               need a session-mode connection, not a transaction-pooled one).

DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# Mollie — één API-sleutel PER LOCATIE/MERK (Het Strand en Zomers hebben
# elk hun eigen Mollie-account, zodat een online kadobon-betaling altijd
# op het account van de juiste eigenaar terechtkomt). Geen terugval naar
# één gedeeld account — ontbreekt de sleutel voor een locatie, dan geeft
# de kadobon-widget voor die locatie een duidelijke foutmelding i.p.v.
# de betaling per ongeluk op het andere account te laten landen.
# Zie src/common/mollie.service.ts voor hoe de locatie-slug naar de
# juiste variabelenaam wordt omgezet.
MOLLIE_API_KEY__HET_STRAND="live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
MOLLIE_API_KEY__ZOMERS="live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
